{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "exi",
  "homepage": "https://exi66.github.io/starter/",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Exi's Theme",
      "description": "Full palette (neutral, 0 radius, brand gradient utilities bg-brand-gradient and text-brand-gradient, focus ring, cursors) overriding base tokens.",
      "cssVars": {
        "light": {
          "radius": "0",
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.205 0 0)",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.97 0 0)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.97 0 0)",
          "muted-foreground": "oklch(0.556 0 0)",
          "accent": "oklch(0.97 0 0)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.922 0 0)",
          "input": "oklch(0.922 0 0)",
          "ring": "oklch(0.708 0 0)",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
          "sidebar": "oklch(0.985 0 0)",
          "sidebar-foreground": "oklch(0.145 0 0)",
          "sidebar-primary": "oklch(0.205 0 0)",
          "sidebar-primary-foreground": "oklch(0.985 0 0)",
          "sidebar-accent": "oklch(0.97 0 0)",
          "sidebar-accent-foreground": "oklch(0.205 0 0)",
          "sidebar-border": "oklch(0.922 0 0)",
          "sidebar-ring": "oklch(0.708 0 0)",
          "brand-1": "oklch(0.736 0.189 339.7)",
          "brand-2": "oklch(0.798 0.093 258.1)",
          "brand-gradient-foreground": "oklch(0.145 0 0)",
          "brand-text-1": "oklch(0.58 0.19 339.7)",
          "brand-text-2": "oklch(0.56 0.1 258.1)"
        },
        "dark": {
          "background": "oklch(0.145 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.205 0 0)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.205 0 0)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.922 0 0)",
          "primary-foreground": "oklch(0.205 0 0)",
          "secondary": "oklch(0.269 0 0)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.269 0 0)",
          "muted-foreground": "oklch(0.708 0 0)",
          "accent": "oklch(0.269 0 0)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.556 0 0)",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
          "sidebar": "oklch(0.205 0 0)",
          "sidebar-foreground": "oklch(0.985 0 0)",
          "sidebar-primary": "oklch(0.488 0.243 264.376)",
          "sidebar-primary-foreground": "oklch(0.985 0 0)",
          "sidebar-accent": "oklch(0.269 0 0)",
          "sidebar-accent-foreground": "oklch(0.985 0 0)",
          "sidebar-border": "oklch(1 0 0 / 10%)",
          "sidebar-ring": "oklch(0.556 0 0)",
          "brand-1": "oklch(0.736 0.189 339.7)",
          "brand-2": "oklch(0.798 0.093 258.1)",
          "brand-gradient-foreground": "oklch(0.145 0 0)",
          "brand-text-1": "oklch(0.736 0.189 339.7)",
          "brand-text-2": "oklch(0.798 0.093 258.1)"
        },
        "theme": {
          "color-brand-1": "var(--brand-1)",
          "color-brand-2": "var(--brand-2)",
          "color-brand-gradient-foreground": "var(--brand-gradient-foreground)",
          "color-brand-text-1": "var(--brand-text-1)",
          "color-brand-text-2": "var(--brand-text-2)",
          "animate-brand-gradient": "brand-gradient 35s ease infinite"
        }
      },
      "css": {
        "@keyframes brand-gradient": {
          "0%, 100%": {
            "background-position": "0% 50%"
          },
          "50%": {
            "background-position": "100% 50%"
          }
        },
        "@utility bg-brand-gradient": {
          "background-image": "linear-gradient(100deg, var(--brand-1), var(--brand-2), var(--brand-1), var(--brand-2))",
          "background-size": "800% 800%",
          "animation": "var(--animate-brand-gradient)"
        },
        "@utility text-brand-gradient": {
          "background-image": "linear-gradient(100deg, var(--brand-text-1), var(--brand-text-2), var(--brand-text-1), var(--brand-text-2))",
          "background-size": "300% 100%",
          "-webkit-background-clip": "text",
          "background-clip": "text",
          "color": "transparent",
          "animation": "var(--animate-brand-gradient)"
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".bg-brand-gradient, .text-brand-gradient": {
            "animation": "none"
          }
        },
        "@layer base": {
          "*": {
            "outline-color": "color-mix(in oklab, var(--ring) 55%, transparent)"
          },
          ":focus-visible": {
            "outline-style": "solid",
            "outline-width": "3px",
            "outline-offset": "0"
          },
          "input:focus-visible, textarea:focus-visible, select:focus-visible": {
            "border-color": "var(--ring)",
            "outline-offset": "0"
          },
          "[data-slot='scroll-area-viewport'] :focus-visible": {
            "outline-offset": "-3px"
          },
          ":focus:not(:focus-visible)": {
            "outline": "none"
          },
          "[tabindex='-1']:focus-visible, [role='dialog']:focus-visible": {
            "outline": "none"
          },
          "button::-moz-focus-inner, [type='button']::-moz-focus-inner, [type='submit']::-moz-focus-inner": {
            "border": "0",
            "padding": "0"
          },
          ":-moz-focusring": {
            "outline-style": "solid",
            "outline-width": "3px"
          },
          ":-moz-focusring:not(:focus-visible)": {
            "outline": "none"
          },
          "body": {
            "-webkit-font-smoothing": "antialiased"
          },
          "button:not(:disabled), [role='button']:not(:disabled), [role='menuitem'], [role='option'], label:has(button), summary": {
            "cursor": "pointer"
          }
        }
      }
    }
  ]
}
